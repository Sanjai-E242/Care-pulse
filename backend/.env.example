# ==============================================================================
# CarePulse AI - Environment Configuration Template (.env.example)
# IMPORTANT: Never commit actual passwords or private tokens to version control.
# ==============================================================================

# Database Configuration (Supabase PostgreSQL in production, MySQL locally)
# Supabase Session Pooler (port 5432):
# SUPABASE_DB_URL=jdbc:postgresql://<db-host>:5432/<db-name>?sslmode=require
# SUPABASE_DB_USERNAME=postgres.<project-ref>
# SUPABASE_DB_PASSWORD=<your-supabase-db-password>
SUPABASE_DB_URL=
SUPABASE_DB_USERNAME=
SUPABASE_DB_PASSWORD=

DATABASE_URL=jdbc:mysql://localhost:3306/carepulse_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DATABASE_USERNAME=root
DATABASE_PASSWORD=
PORT=8080

JWT_SECRET=YourSecureRandomKeyMustBeAtLeast256BitsLongForHmacSha256
JWT_EXPIRATION_MS=86400000

CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-carepulse.vercel.app

VITE_API_BASE_URL=http://localhost:8080/api

AI_API_KEY=
AI_MODEL=gemini-1.5-flash
